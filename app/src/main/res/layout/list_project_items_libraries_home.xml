<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="@drawable/bg_status"
    android:padding="10dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <androidx.cardview.widget.CardView
        android:id="@+id/imgCardProject"
        android:layout_width="150dp"
        android:layout_height="90dp"
        android:elevation="0dp"
        app:cardBackgroundColor="@color/bg_color"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_project_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/p1" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginStart="5dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_status">

            <TextView
                android:id="@+id/category_name_item_project_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tittle_font"
                android:text="Library"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textDirection="ltr"
                android:textFontWeight="700"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bookmarkBtn"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="start"
        android:layout_marginEnd="5dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_status"
        tools:ignore="MissingConstraints"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/icon_bookmark"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/bookmark"
            android:tint="@color/white"
            tools:ignore="UseAppTint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/name_project_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/tittle_font"
        android:text="@string/name_project"
        android:textColor="@color/white"
        android:textFontWeight="500"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@id/imgCardProject"
        app:layout_constraintTop_toBottomOf="@id/imgCardProject" />

    <TextView
        android:id="@+id/des_item_project"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/body_entry_font"
        android:maxLength="23"
        android:layout_marginStart="5dp"
        android:text="@string/des_project_item"
        android:textColor="@color/gray"
        android:textDirection="ltr"
        android:textFontWeight="300"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/name_project_item"
        app:layout_constraintTop_toBottomOf="@id/name_project_item" />

    <View
        android:id="@+id/line_project_item"
        android:layout_width="100dp"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:alpha="0.4"
        android:background="@drawable/bg_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/des_item_project" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pointBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="5dp"
        android:paddingStart="5dp"
        android:paddingEnd="10dp"
        android:background="@drawable/bg_status"
        tools:ignore="MissingConstraints"
        app:layout_constraintTop_toBottomOf="@id/line_project_item"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp">
        <ImageView
            android:id="@+id/icon_point"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_sparkles"
            android:tint="@color/gold"
            tools:ignore="UseAppTint"
            android:layout_marginEnd="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/point_item_project_home"/>

        <TextView
            android:id="@+id/point_item_project_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/number_font"
            android:text="4.5"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textDirection="ltr"
            android:textFontWeight="700"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/icon_point"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/show_more_project"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toTopOf="@id/pointBack"
        app:layout_constraintBottom_toBottomOf="@+id/pointBack"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_status">
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/arrow_right"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:rotation="-45"
            android:backgroundTint="@color/white"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>