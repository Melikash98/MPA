<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    tools:context=".HomeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/section_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/textLogoHome"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_signature_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/textLogoHome"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/textLogoHome">

            <ImageView
                android:id="@+id/search_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/search"
                android:backgroundTint="@color/gray"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/notif_bell"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/notif_bell"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bell"
                android:backgroundTint="@color/gray"
                app:layout_constraintBottom_toBottomOf="@id/notif_bell"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/notif_bell" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/section_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/section_one">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/banner_layout"
            android:layout_width="420dp"
            android:layout_height="250dp"
            android:background="@drawable/card_no_buttons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/hire_btn"
                android:layout_width="150dp"
                android:layout_height="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="50dp"
                android:layout_marginBottom="15dp"
                android:text="@string/hire_me"
                android:fontFamily="@font/body_entry_font"
                android:textFontWeight="600"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@color/ic_launcher_background"
                android:background="@drawable/bg_gold_btn"/>
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:elevation="10dp"
                android:src="@drawable/work"
                android:layout_marginStart="20dp"
                android:tint="@color/ic_launcher_background"
                app:layout_constraintStart_toStartOf="@id/hire_btn"
                app:layout_constraintTop_toTopOf="@id/hire_btn"
                app:layout_constraintBottom_toBottomOf="@id/hire_btn"
                tools:ignore="UseAppTint" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/work_btn"
                android:layout_width="150dp"
                android:layout_height="32dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/hire_btn"
                app:layout_constraintBottom_toBottomOf="@id/hire_btn"
                android:layout_marginEnd="40dp"
                android:text="@string/go_work"
                android:fontFamily="@font/body_entry_font"
                android:textFontWeight="600"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/bg_gold_border_btn"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/banner_layout"
            android:layout_marginTop="10dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <LinearLayout
                    android:id="@+id/year_layout"
                    android:layout_marginStart="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:orientation="vertical"
                    android:padding="0dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/ex_years_nm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textSize="18sp"
                        android:textFontWeight="900"
                        android:fontFamily="@font/number_font"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:drawableStart="@drawable/plus"
                        android:drawableTint="@color/white"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/years"
                        android:textAllCaps="false"
                        android:fontFamily="@font/body_entry_font"
                        android:textSize="14sp"
                        android:textColor="@color/gray"
                        android:alpha="0.6"
                        android:layout_gravity="center"
                        android:gravity="center"/>
                </LinearLayout>
                <View
                    android:id="@+id/view_one"
                    android:layout_width="2dp"
                    android:layout_height="50dp"
                    app:layout_constraintStart_toEndOf="@id/year_layout"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/bg_line"
                    app:layout_constraintTop_toTopOf="parent"
                    android:alpha="0.3"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <LinearLayout
                    android:id="@+id/projects_layout"
                    android:layout_marginStart="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    app:layout_constraintTop_toTopOf="@id/year_layout"
                    app:layout_constraintBottom_toBottomOf="@id/year_layout"
                    app:layout_constraintStart_toEndOf="@id/view_one"
                    android:orientation="vertical"
                    android:padding="0dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/pr_com_nm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18"
                        android:textSize="16sp"
                        android:textFontWeight="900"
                        android:fontFamily="@font/number_font"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:drawableStart="@drawable/plus"
                        android:drawableTint="@color/white"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/projects_status"
                        android:textAllCaps="false"
                        android:fontFamily="@font/body_entry_font"
                        android:textSize="14sp"
                        android:textColor="@color/gray"
                        android:alpha="0.6"
                        android:layout_gravity="center"
                        android:gravity="center"/>
                </LinearLayout>
                <View
                    android:id="@+id/view_two"
                    android:layout_width="2dp"
                    android:layout_height="50dp"
                    app:layout_constraintStart_toEndOf="@id/projects_layout"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/bg_line"
                    app:layout_constraintTop_toTopOf="parent"
                    android:alpha="0.3"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <LinearLayout
                    android:id="@+id/co_layout"
                    android:layout_marginStart="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    app:layout_constraintTop_toTopOf="@id/year_layout"
                    app:layout_constraintBottom_toBottomOf="@id/year_layout"
                    app:layout_constraintStart_toEndOf="@id/view_two"
                    android:orientation="vertical"
                    android:padding="0dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/co_vedio_nm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6"
                        android:textSize="16sp"
                        android:textFontWeight="900"
                        android:fontFamily="@font/number_font"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:drawableStart="@drawable/plus"
                        android:drawableTint="@color/white"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/move_status"
                        android:textAllCaps="false"
                        android:fontFamily="@font/body_entry_font"
                        android:textSize="14sp"
                        android:textColor="@color/gray"
                        android:alpha="0.6"
                        android:layout_gravity="center"
                        android:gravity="center"/>
                </LinearLayout>
                <View
                    android:id="@+id/view_three"
                    android:layout_width="2dp"
                    android:layout_height="50dp"
                    app:layout_constraintStart_toEndOf="@id/co_layout"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/bg_line"
                    app:layout_constraintTop_toTopOf="parent"
                    android:alpha="0.3"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <LinearLayout
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="20dp"
                    android:id="@+id/com_layout"
                    android:layout_marginStart="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    app:layout_constraintTop_toTopOf="@id/year_layout"
                    app:layout_constraintBottom_toBottomOf="@id/year_layout"
                    app:layout_constraintStart_toEndOf="@id/view_three"
                    android:orientation="vertical"
                    android:padding="0dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/com_nm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100"
                        android:textSize="16sp"
                        android:textFontWeight="900"
                        android:fontFamily="@font/number_font"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:drawableStart="@drawable/plus"
                        android:drawableTint="@color/white"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comments"
                        android:textAllCaps="false"
                        android:fontFamily="@font/body_entry_font"
                        android:textSize="14sp"
                        android:textColor="@color/gray"
                        android:alpha="0.6"
                        android:layout_gravity="center"
                        android:gravity="center"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/section_three"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/section_two"
        android:layout_marginTop="10dp"
        android:padding="10dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
           <androidx.recyclerview.widget.RecyclerView
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintEnd_toEndOf="parent"
               app:layout_constraintTop_toTopOf="parent"
               app:layout_constraintBottom_toBottomOf="parent"
               android:id="@+id/navigation_card_rec"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/section_three"
        android:layout_marginTop="10dp"
        android:id="@+id/section_four"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_project"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/project_tittle_home"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:fontFamily="@font/tittle_font"
            android:textFontWeight="700"
            android:textAllCaps="false"/>
        <TextView
            android:id="@+id/go_to_project_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/see"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/project_tittle_home"
            app:layout_constraintBottom_toBottomOf="@id/project_tittle_home"
            android:textSize="16sp"
            android:textColor="@color/red_medium"
            android:fontFamily="@font/nav_font"
            android:textFontWeight="700"
            android:textAllCaps="false"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/new_project_rec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/section_four"
        android:layout_margin="10dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/new_project_rec"
        android:layout_marginTop="10dp"
        android:id="@+id/section_five"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_courses"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/course_tittle_home"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:fontFamily="@font/tittle_font"
            android:textFontWeight="700"
            android:textAllCaps="false"/>
        <TextView
            android:id="@+id/go_to_course_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/see"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/course_tittle_home"
            app:layout_constraintBottom_toBottomOf="@id/course_tittle_home"
            android:textSize="16sp"
            android:textColor="@color/red_medium"
            android:fontFamily="@font/nav_font"
            android:textFontWeight="700"
            android:textAllCaps="false"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/new_course_rec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/section_five"
        android:layout_margin="10dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>