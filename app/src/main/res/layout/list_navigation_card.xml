<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="95dp"
    android:layout_height="95dp"
    android:id="@+id/cadr_list"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    android:layout_margin="5dp"
    android:padding="10dp"
    android:background="@drawable/bg_status">
    <ImageView
        android:id="@+id/bg_icon_nav_card"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/bg_nav_card_list"/>
    <ImageView
        android:id="@+id/icon_nav_card"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintStart_toStartOf="@id/bg_icon_nav_card"
        app:layout_constraintEnd_toEndOf="@id/bg_icon_nav_card"
        app:layout_constraintTop_toTopOf="@id/bg_icon_nav_card"
        app:layout_constraintBottom_toBottomOf="@id/bg_icon_nav_card"
        android:tint="@color/gold_deep"
        android:src="@drawable/work"/>
    <TextView
        android:id="@+id/name_nav_list_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hire_me"
        app:layout_constraintStart_toStartOf="@id/bg_icon_nav_card"
        app:layout_constraintEnd_toEndOf="@id/bg_icon_nav_card"
        app:layout_constraintTop_toBottomOf="@id/bg_icon_nav_card"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:layout_marginTop="7dp"
        android:fontFamily="@font/nav_font"
        android:textFontWeight="600" />

</androidx.constraintlayout.widget.ConstraintLayout>