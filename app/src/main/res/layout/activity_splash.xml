<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SplashActivity"
    android:background="@color/ic_launcher_background">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="700dp"
            android:background="@drawable/bg_splash_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/star_one"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_sparkles"
            android:tint="@color/gold"
            android:backgroundTint="@color/gold"
            app:layout_constraintEnd_toStartOf="@id/logoImg"
            android:layout_marginEnd="-150dp"
            app:layout_constraintTop_toTopOf="@id/logoImg"
            android:layout_marginTop="250dp"
           />
        <ImageView
            android:id="@+id/star_foure"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_sparkles"
            android:tint="@color/gold"
            android:backgroundTint="@color/gold"
            app:layout_constraintEnd_toStartOf="@id/logoImg"
            android:layout_marginEnd="-250dp"
            app:layout_constraintTop_toTopOf="@id/logoImg"
            android:layout_marginTop="150dp"
            />
        <ImageView
            android:id="@+id/star_two"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_sparkles"
            android:tint="@color/gold"
            android:backgroundTint="@color/gold"
            app:layout_constraintStart_toEndOf="@id/logoImg"
            android:layout_marginStart="-150dp"
            app:layout_constraintTop_toTopOf="@id/logoImg"
            android:layout_marginTop="150dp"/>
        <ImageView
            android:id="@+id/star_three"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_sparkles"
            android:tint="@color/gold"
            android:backgroundTint="@color/gold"
            app:layout_constraintStart_toEndOf="@id/logoImg"
            android:layout_marginStart="-150dp"
            app:layout_constraintTop_toTopOf="@id/logoImg"
            android:layout_marginTop="260dp"/>
        <ImageView
            android:id="@+id/star_five"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_sparkles"
            android:tint="@color/gold"
            android:backgroundTint="@color/gold"
            app:layout_constraintStart_toEndOf="@id/logoImg"
            android:layout_marginStart="-350dp"
            app:layout_constraintTop_toTopOf="@id/logoImg"
            android:layout_marginTop="450dp"
            android:alpha="0.4"/>
        <ImageView
            android:id="@+id/star_sex"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_sparkles"
            android:tint="@color/gold"
            android:backgroundTint="@color/gold"
            app:layout_constraintStart_toEndOf="@id/logoImg"
            android:layout_marginStart="-450dp"
            app:layout_constraintTop_toTopOf="@id/logoImg"
            android:layout_marginTop="430dp"/>
        <ImageView
            android:id="@+id/star_seven"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_sparkles"
            android:tint="@color/gold"
            android:backgroundTint="@color/gold"
            app:layout_constraintStart_toEndOf="@id/logoImg"
            android:layout_marginStart="-150dp"
            app:layout_constraintTop_toTopOf="@id/logoImg"
            android:layout_marginTop="400dp"/>
        <ImageView
            android:id="@+id/logoImg"
            android:layout_width="550dp"
            android:layout_height="550dp"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/ic_splash"/>

        <ImageView
            android:id="@+id/logoText"
            android:layout_width="300dp"
            android:layout_height="200dp"
            android:src="@drawable/logo_signature"
            app:layout_constraintStart_toStartOf="@id/logoImg"
            app:layout_constraintEnd_toEndOf="@id/logoImg"
            app:layout_constraintTop_toBottomOf="@id/logoImg"
            android:layout_marginTop="-220dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/text_one"
            app:layout_constraintTop_toBottomOf="@id/logoText"
            app:layout_constraintStart_toStartOf="@id/logoText"
            app:layout_constraintEnd_toEndOf="@id/logoText"
            android:text="@string/text_splash"
            android:textColor="@color/gold"
            android:layout_marginTop="-50dp"
            android:fontFamily="@font/inter_bold"
            android:textSize="16sp"
            android:letterSpacing=".2"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/text_one"
            app:layout_constraintEnd_toEndOf="@id/text_one"
            app:layout_constraintTop_toBottomOf="@id/text_one"
            android:text="@string/text_splash_two"
            android:textSize="12sp"
            android:textColor="@color/gray"
            android:alpha="0.5"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_bold"
            android:textFontWeight="500"/>
    </androidx.constraintlayout.widget.ConstraintLayout>




</androidx.constraintlayout.widget.ConstraintLayout>